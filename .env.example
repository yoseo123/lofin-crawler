# 선택: 웹 UI 세션 키. 비워두면 실행 때마다 임시 키를 생성합니다.
LOFIN_WEB_SECRET_KEY=
LOFIN_WEB_COOKIE_SECURE=false
LOFIN_ALLOWED_ORIGINS=
LOFIN_ALLOW_REMOTE=false
LOFIN_WEB_HOST=0.0.0.0
LOFIN_WEB_PORT=8787

# 선택: 유사 정책 검색(RAG) 기능.
LOFIN_QDRANT_URL=http://127.0.0.1:6333
LOFIN_QDRANT_COLLECTION=policy_cases_v1
LOFIN_EMBEDDING_MODEL=text-embedding-3-large
LOFIN_EMBEDDING_DIMENSIONS=1536

# Optional Jev reranker: setting either key enables external, paid BeatAPI calls.
# Search query + candidate policy text are sent to BeatAPI. Keep keys server-side.
LOFIN_JEV_API_KEY=
# BEATAPI_API_KEY=  # fallback when LOFIN_JEV_API_KEY is unset
LOFIN_JEV_THRESHOLD=0.6
LOFIN_JEV_MODEL=jev-1.14
